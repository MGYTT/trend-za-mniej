{
  "manifest_version": 3,
  "name": "Trendzamniej — Kody i promocje",
  "version": "0.4.0",
  "description": "Kody i promocje sklepów z panelem otwieranym wyłącznie po kliknięciu użytkownika, bez automatycznego sprawdzania koszyka.",
  "homepage_url": "https://trendzamniej.pl",
  "action": {
    "default_title": "Trendzamniej — znajdź promocje",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://trendzamniej.pl/*"
  ]
}
